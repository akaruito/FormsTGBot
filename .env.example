# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FORM_SIGNING_KEY=

# Leave these empty for a local run that only exercises the public form.
BOT_TOKEN=
WEB_APP_URL=
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
TRUST_PROXY_HEADERS=false
# Set a retention period in days to automatically purge old active forms.
ACTIVE_FORMS_RETENTION_DAYS=0

# Production example:
# WEB_APP_URL=https://forms.example.com/miniapp
# TRUSTED_HOSTS=forms.example.com
# TRUST_PROXY_HEADERS=true
# DATABASE_PATH=/var/lib/forms-tgbot/forms.db
